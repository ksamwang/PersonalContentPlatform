[Unit]
Description=Personal Content Platform API
After=network-online.target
[Service]
User=pcplatform
Group=pcplatform
WorkingDirectory=/opt/pcplatform
EnvironmentFile=/etc/pcplatform/pcplatform.env
ExecStart=/opt/pcplatform/bin/pcp-api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pcplatform
[Install]
WantedBy=multi-user.target
