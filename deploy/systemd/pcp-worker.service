[Unit]
Description=Personal Content Platform Worker
After=network-online.target pcp-api.service
[Service]
User=pcplatform
Group=pcplatform
WorkingDirectory=/opt/pcplatform
EnvironmentFile=/etc/pcplatform/pcplatform.env
ExecStart=/opt/pcplatform/bin/pcp-worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pcplatform
[Install]
WantedBy=multi-user.target
